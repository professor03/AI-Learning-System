{
  "name": "AI Learning System + real YOLO demo",
  "image": "mcr.microsoft.com/devcontainers/python:1-3.12-bookworm",
  "features": {
    "ghcr.io/devcontainers/features/node:1": { "version": "22" },
    "ghcr.io/devcontainers/features/github-cli:1": {}
  },
  "hostRequirements": { "cpus": 2, "memory": "8gb", "storage": "32gb" },
  "forwardPorts": [8787],
  "portsAttributes": {
    "8787": { "label": "AI Learning System / LearnSight real demo", "onAutoForward": "openBrowser", "protocol": "http" },
    "8000": { "onAutoForward": "ignore" }
  },
  "postCreateCommand": "python scripts/codespaces_setup.py",
  "postStartCommand": "python scripts/codespaces_start.py",
  "remoteUser": "vscode"
}
